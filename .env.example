# Copy to your environment (these are read by the server at startup). All optional.
PORT=3000
# Set to 1 when served over HTTPS so the session cookie is marked Secure
SECURE_COOKIES=0
# DB_FILE=./data/crm.db

# Analytics / onboarding - each integration only loads in the browser when its ID is set
GA_MEASUREMENT_ID=        # Google Analytics 4, e.g. G-XXXXXXXXXX
GTM_CONTAINER_ID=         # Google Tag Manager, e.g. GTM-XXXXXXX
CLARITY_PROJECT_ID=       # Microsoft Clarity project id
PENDO_API_KEY=            # Pendo (analytics + in-app onboarding guides)

# Google Maps JavaScript API key (offices map). Restrict it to your domain in Google Cloud console.
GOOGLE_MAPS_API_KEY=
