{
  "name": "Finnally CRM",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "postCreateCommand": "npm run setup && npm run build",
  "postAttachCommand": "npm start",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Finnally CRM", "onAutoForward": "openBrowser" }
  },
  "hostRequirements": { "cpus": 2 }
}
